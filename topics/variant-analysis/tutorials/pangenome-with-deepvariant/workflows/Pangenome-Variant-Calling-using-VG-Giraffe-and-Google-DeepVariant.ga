            "tool_state": "{\"code\": \"BEGIN {\\n    clean_var_1 = VAR1\\n    clean_var_2 = VAR2\\n    \\n    # Strip leading and trailing spaces/tabs\\n    gsub(/^[ \\\\t]+|[ \\\\t]+$/, \\\"\\\", clean_var_1)\\n    gsub(/^[ \\\\t]+|[ \\\\t]+$/, \\\"\\\", clean_var_2)\\n\\n    if (length(clean_var_2) > 0) {\\n        # Append \\\"--\\\" to prune-low-cplx for vg giraffe to understand\\n        clean_var_2 = \\\"--\\\" clean_var_2\\n    }\\n    \\n    if (length(clean_var_1) > 0 && length(clean_var_2) > 0) {\\n        print clean_var_1 \\\",\\\" clean_var_2\\n    } else {\\n        print clean_var_1 clean_var_2\\n    }\\n    exit\\n}\", \"infile\": {\"__class__\": \"ConnectedValue\"}, \"variables\": [{\"__index__\": 0, \"value\": {\"__class__\": \"ConnectedValue\"}}, {\"__index__\": 1, \"value\": {\"__class__\": \"ConnectedValue\"}}], \"__page__\": 0, \"__rerun_remap_job_id__\": null}",
