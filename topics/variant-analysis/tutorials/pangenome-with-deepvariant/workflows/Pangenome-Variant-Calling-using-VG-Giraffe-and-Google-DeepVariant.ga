                "tool_shed": "toolshed.g2.bx.psu.edu"
            },
            "tool_state": "{\"code\": \"!/(_decoy|_random|chrUn_|chrEBV|chrM|chain_)/ {\\n    # Split path by the path separator '#'\\n    n = split($0, parts, \\\"#\\\");\\n    \\n    if (n >= 3) {\\n        # HAPLOTYPE (e.g. sample#hap#contig#block) or REFERENCE with Haplotype (e.g.. sample#hap#contig)\\n        contig = parts[3];\\n    } else if (n == 2) {\\n        # REFERENCE without Haplotype (e.g. sample#contig)\\n        contig = parts[2];\\n    } else {\\n        # GENERIC\\n        contig = $0;\\n    }\\n    \\n    # Remove any subranges (e.g. chr1[1000-2000] -> chr1)\\n    sub(/\\\\[.*/, \\\"\\\", contig);\\n    \\n    if (!seen[contig]++) {\\n        print contig;\\n    }\\n}\\n\", \"infile\": {\"__class__\": \"ConnectedValue\"}, \"variables\": [], \"__page__\": 0, \"__rerun_remap_job_id__\": null}",
            "tool_uuid": null,
            "tool_version": "9.5+galaxy3",
