            "tool_state": "{\"add_to_database\": {\"withdb\": {\"__class__\": \"RuntimeValue\"}}, \"addqueries\": {\"queries\": []}, \"modify_database\": {\"sql_stmts\": []}, \"query_result\": {\"header\": \"yes\", \"__current_case__\": 0, \"header_prefix\": \"35\"}, \"save_db\": false, \"sqlquery\": \"SELECT * FROM (\\nWITH ranked AS (\\n    SELECT CAST(total_counts AS REAL) AS total_counts,\\n           CAST(n_genes_by_counts AS REAL) AS n_genes_by_counts,\\n           ROW_NUMBER() OVER (ORDER BY CAST(total_counts AS REAL)) AS r_counts,\\n           ROW_NUMBER() OVER (ORDER BY CAST(n_genes_by_counts AS REAL)) AS r_genes,\\n           COUNT(*) OVER () AS n\\n    FROM obs\\n)\\nSELECT COUNT(*) AS spots,\\n       MIN(total_counts) AS min_total_counts,\\n       (SELECT AVG(total_counts) FROM ranked WHERE r_counts IN ((n+1)/2, (n+2)/2)) AS median_total_counts,\\n       MAX(total_counts) AS max_total_counts,\\n       MIN(n_genes_by_counts) AS min_n_genes_by_counts,\\n       (SELECT AVG(n_genes_by_counts) FROM ranked WHERE r_genes IN ((n+1)/2, (n+2)/2)) AS median_n_genes_by_counts,\\n       MAX(n_genes_by_counts) AS max_n_genes_by_counts\\nFROM ranked\\n) AS evidence_results;\", \"tables\": [{\"__index__\": 0, \"table\": {\"__class__\": \"ConnectedValue\"}, \"input_opts\": {\"linefilters\": []}, \"tbl_opts\": {\"table_name\": \"obs\", \"column_names_from_first_line\": true, \"col_names\": \"\", \"load_named_columns\": false, \"pkey_autoincr\": \"\", \"indexes\": []}}], \"workdb\": \"workdb.sqlite\", \"__page__\": null, \"__rerun_remap_job_id__\": null}",
