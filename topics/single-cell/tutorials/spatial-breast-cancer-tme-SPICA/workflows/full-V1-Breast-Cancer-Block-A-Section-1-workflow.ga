            "tool_state": "{\"add_to_database\": {\"withdb\": {\"__class__\": \"RuntimeValue\"}}, \"addqueries\": {\"queries\": []}, \"modify_database\": {\"sql_stmts\": []}, \"query_result\": {\"header\": \"yes\", \"__current_case__\": 0, \"header_prefix\": \"35\"}, \"save_db\": false, \"sqlquery\": \"SELECT * FROM (\\nWITH j AS (\\n  SELECT CAST(o.total_counts AS REAL) AS counts,\\n         CAST(p.\\\"0\\\" AS REAL) AS pc1,\\n         CAST(p.\\\"1\\\" AS REAL) AS pc2,\\n         CAST(p.\\\"2\\\" AS REAL) AS pc3\\n  FROM obs AS o JOIN pcs AS p ON o.rowid = p.rowid\\n),\\ncentered AS (\\n  SELECT *,\\n         AVG(counts) OVER () AS m_counts,\\n         AVG(pc1) OVER () AS m_pc1,\\n         AVG(pc2) OVER () AS m_pc2,\\n         AVG(pc3) OVER () AS m_pc3\\n  FROM j\\n)\\nSELECT COUNT(*) AS spots,\\n       SUM((counts-m_counts)*(pc1-m_pc1)) / SQRT(SUM((counts-m_counts)*(counts-m_counts))*SUM((pc1-m_pc1)*(pc1-m_pc1))) AS total_counts_vs_pc1,\\n       SUM((counts-m_counts)*(pc2-m_pc2)) / SQRT(SUM((counts-m_counts)*(counts-m_counts))*SUM((pc2-m_pc2)*(pc2-m_pc2))) AS total_counts_vs_pc2,\\n       SUM((counts-m_counts)*(pc3-m_pc3)) / SQRT(SUM((counts-m_counts)*(counts-m_counts))*SUM((pc3-m_pc3)*(pc3-m_pc3))) AS total_counts_vs_pc3\\nFROM centered\\n) AS evidence_results;\", \"tables\": [{\"__index__\": 0, \"table\": {\"__class__\": \"ConnectedValue\"}, \"input_opts\": {\"linefilters\": []}, \"tbl_opts\": {\"table_name\": \"obs\", \"column_names_from_first_line\": true, \"col_names\": \"\", \"load_named_columns\": false, \"pkey_autoincr\": \"\", \"indexes\": []}}, {\"__index__\": 1, \"table\": {\"__class__\": \"ConnectedValue\"}, \"input_opts\": {\"linefilters\": []}, \"tbl_opts\": {\"table_name\": \"pcs\", \"column_names_from_first_line\": true, \"col_names\": \"\", \"load_named_columns\": false, \"pkey_autoincr\": \"\", \"indexes\": []}}], \"workdb\": \"workdb.sqlite\", \"__page__\": null, \"__rerun_remap_job_id__\": null}",
